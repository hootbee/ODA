FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache \
  chromium nss freetype harfbuzz ttf-freefont ca-certificates udev dumb-init

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

RUN addgroup -S pptr && adduser -S -G pptr pptr
RUN mkdir -p /home/pptr/Downloads /app/tmp /app/node_modules \
    && chown -R pptr:pptr /home/pptr /app
USER pptr

COPY package.json package-lock.json* ./
RUN npm ci

EXPOSE 3001
CMD ["npm", "run", "dev"]